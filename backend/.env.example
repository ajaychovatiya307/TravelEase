# TravelEase backend environment template — PLACEHOLDERS ONLY.
#
# Local development: copy to backend/.env (git-ignored) and fill in your own values.
# Every service reads backend/.env automatically when started from backend/ (or its own folder),
# via spring.config.import in each application.yml. Real environment variables take precedence.
#
# Production: do NOT use a .env file. Supply these through your platform's secret manager
# (e.g. Kubernetes Secrets, AWS Secrets Manager, Vault) and run with SPRING_PROFILES_ACTIVE=prod.
# With the prod profile, startup fails if any of these are missing or a known default.

# Shared HS256 JWT secret: the same value in every service, at least 32 random bytes.
# Generate one with:  openssl rand -base64 48
TRAVELEASE_JWT_SECRET=<generate-a-random-secret>

# MySQL credentials used by all services (use a dedicated least-privilege account, not root).
TRAVELEASE_DB_USERNAME=<db-username>
TRAVELEASE_DB_PASSWORD=<db-password>
# Optional: MySQL host/port (default localhost:3306).
# TRAVELEASE_DB_HOST=localhost
# TRAVELEASE_DB_PORT=3306

# Service-to-service credential secret (event ingestion, admin /internal/** endpoints). Same value in
# every service, at least 32 random bytes, and DIFFERENT from TRAVELEASE_JWT_SECRET.
# Generate one with:  openssl rand -base64 48
TRAVELEASE_INTERNAL_SECRET=<generate-a-different-random-secret>

# Document storage for travel-request and expense uploads. Required (absolute, persistent and backed up)
# with the prod profile; defaults to ~/.travelease/documents for local development.
# TRAVELEASE_STORAGE_DIR=/var/lib/travelease/documents

# Service locations (defaults are the local ports).
# ADMIN_SERVICE_INTERNAL_URL=http://localhost:8082
# ADMIN_SERVICE_API_URL=http://localhost:8082/api
# TRAVEL_REQUEST_SERVICE_API_URL=http://localhost:8081/api
# AUDIT_EVENTS_URL=http://localhost:8084/api/events
# NOTIFICATION_EVENTS_URL=http://localhost:8085/api/events

# First administrator of a fresh (non-dev) environment. Used only while no active ADMIN exists; the
# account must change this password at first sign-in. Remove both values afterwards.
# TRAVELEASE_BOOTSTRAP_ADMIN_EMAIL=<admin-email>
# TRAVELEASE_BOOTSTRAP_ADMIN_PASSWORD=<10+ chars, letters and digits>

# E-mail notifications (notification-service). OFF by default: in-app notifications work without it.
# Enabling it without TRAVELEASE_SMTP_HOST makes startup fail; nothing is e-mailed until real SMTP
# credentials are supplied.
# TRAVELEASE_EMAIL_ENABLED=false
# TRAVELEASE_EMAIL_FROM=<no-reply@your-domain>
# TRAVELEASE_SMTP_HOST=<smtp-host>
# TRAVELEASE_SMTP_PORT=587
# TRAVELEASE_SMTP_USERNAME=<smtp-username>
# TRAVELEASE_SMTP_PASSWORD=<smtp-password>
# TRAVELEASE_APP_BASE_URL=http://localhost:5173

# Local development only: to opt in to demo data (demo accounts, sample travel requests and
# expense claims), start the admin, travel-request and expense services with the environment
# variable SPRING_PROFILES_ACTIVE=dev (set it in your shell; profiles cannot be activated from this file).
# Never use the dev profile in production — startup fails if it is combined with prod while seeding is on.
# Required with the dev profile: password for the demo accounts created on an EMPTY database.
# TRAVELEASE_SEED_PASSWORD=<dev-demo-password>
